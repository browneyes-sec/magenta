{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Magenta Cloud Providers",
  "description": "JSON Schema for soa/config/providers.toml",
  "type": "object",
  "required": ["schema", "providers"],
  "properties": {
    "schema": {
      "type": "object",
      "properties": {
        "version": { "type": "string" }
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "enabled"],
        "properties": {
          "id": { "type": "string", "enum": ["azure", "aws", "gcp", "vsphere", "edge-k3s"] },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["public", "private", "edge"] },
          "enabled": { "type": "boolean" },
          "priority": { "type": "integer", "minimum": 1, "maximum": 10 },
          "default_region": { "type": "string" },
          "auth_method": { "type": "string" },
          "finops": {
            "type": "object",
            "properties": {
              "monthly_budget": { "type": "number", "minimum": 0 }
            }
          }
        }
      },
      "minItems": 1
    }
  }
}
