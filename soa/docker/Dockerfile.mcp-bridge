# MCP Protocol Bridge — Universal Tool Gateway
# Distroless base image (~80MB vs ~300MB with python:3.12-slim)
#
# Build: docker build -t magenta/mcp-bridge:latest -f soa/docker/Dockerfile.mcp-bridge .
# Size: ~130MB (distroless base + app + grpcurl)

FROM magenta/base:distroless AS builder

WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Install dependencies
COPY pyproject.toml /app/
RUN uv sync --frozen --no-dev

# ── Runtime ───────────────────────────────────────────────────────────────

FROM magenta/base:distroless

WORKDIR /app

# Copy venv from builder
COPY --from=builder /app/.venv /app/.venv

# Copy application code
COPY mcp_bridge/ /app/mcp_bridge/
COPY config/ /app/config/

# Non-root user (inherited from base)
USER 10001:10001

EXPOSE 8080 50051 9090

HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8080/mcp/health')"]

ENTRYPOINT ["python", "-m", "mcp_bridge.server"]
CMD ["--config", "/app/config/system.toml", "--port", "8080"]
