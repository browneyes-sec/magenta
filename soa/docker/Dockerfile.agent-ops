# Agent Ops — Configuration, IaC, Multi-Cloud, FinOps Runtime
# Distroless base image (~80MB vs ~1.5GB with full agent-ops)
#
# This is the CORE image only. Terraform + cloud CLIs are in the sidecar image.
# For the full agent-ops with Terraform, use Dockerfile.tf-sidecar.
#
# Build: docker build -t magenta/agent-ops:latest -f soa/docker/Dockerfile.agent-ops .
# Size: ~150MB (distroless base + app)
#
# K8s: Deploy as separate pods with sidecar for Terraform operations.

FROM magenta/base:distroless AS builder

WORKDIR /app

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Python dependencies
COPY pyproject.toml uv.lock README.md /app/
RUN uv sync --frozen --no-dev

# ── Runtime ───────────────────────────────────────────────────────────────

FROM magenta/base:distroless

WORKDIR /app

# Copy venv from builder
COPY --from=builder /app/.venv /app/.venv

# Copy application code
COPY magenta/ /app/magenta/
COPY soa/config/ /app/config/

# Non-root user (inherited from base)
USER 10001:10001

EXPOSE 50060 9090

HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:50060/mcp/agent-ops/health')"]

ENTRYPOINT ["python", "-m", "magenta.agent_ops.server"]
CMD ["--config", "/app/config/agents.toml", "--port", "50060"]
