# Agent Orchestrator — Swarm Manager Runtime
# Distroless base image (~80MB vs ~300MB with python:3.12-slim)
#
# Build: docker build -t magenta/agent-orchestrator:latest -f soa/docker/Dockerfile.agent-orchestrator .
# Size: ~120MB (distroless base + app)

FROM magenta/base:distroless AS builder

WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
COPY pyproject.toml /app/
RUN uv sync --frozen --no-dev

# ── Runtime ───────────────────────────────────────────────────────────────

FROM magenta/base:distroless

WORKDIR /app

# Copy venv from builder
COPY --from=builder /app/.venv /app/.venv

# Copy application code
COPY agent_orchestrator/ /app/agent_orchestrator/
COPY soa/config/ /app/config/
COPY magenta/core/ /app/magenta/core/

# Non-root user (inherited from base)
USER 10001:10001

EXPOSE 50061 9090

HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:50061/mcp/orchestrator/health')"]

ENTRYPOINT ["python", "-m", "agent_orchestrator.server"]
CMD ["--config", "/app/config/system.toml", "--port", "50061"]
