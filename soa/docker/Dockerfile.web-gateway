# MCP Web Gateway — HTTP/REST API MCP Wrapper
# Proxies agent requests to the Magenta REST API.
# Exposes MCP tools for web resource query and health checks.

FROM python:3.12-slim AS builder

WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
COPY pyproject.toml /app/
RUN uv sync --frozen

# ── Runtime ──────────────────────────────────────────────────────────────

FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/.venv /app/.venv
COPY web_gateway/ /app/web_gateway/
COPY soa/config/ /app/config/

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1

EXPOSE 8081 9090

HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
    CMD curl -sf http://localhost:8081/mcp/web/health || exit 1

ENTRYPOINT ["python", "-m", "web_gateway.server"]
CMD ["--config", "/app/config/web-service.toml", "--port", "8081"]
