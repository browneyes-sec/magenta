{
  "title": "Open WebUI — Usage & Performance",
  "uid": "openwebui-usage",
  "version": 1,
  "tags": ["magenta", "openwebui", "usage"],
  "timezone": "browser",
  "editable": false,
  "panels": [
    {
      "title": "Active User Sessions",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 6},
      "datasource": {"type": "prometheus", "uid": "magenta-prometheus"},
      "targets": [{"expr": "magenta_webui_active_sessions", "legendFormat": "Active Sessions"}],
      "fieldConfig": {
        "defaults": {"unit": "short", "min": 0},
        "overrides": []
      }
    },
    {
      "title": "Model Usage Distribution",
      "type": "piechart",
      "gridPos": {"x": 8, "y": 0, "w": 6, "h": 6},
      "datasource": {"type": "prometheus", "uid": "magenta-prometheus"},
      "targets": [{"expr": "sum(magenta_webui_model_requests_total) by (model)", "legendFormat": "{{model}}"}],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "title": "LLM Request Latency (P50/P95/P99)",
      "type": "timeseries",
      "gridPos": {"x": 14, "y": 0, "w": 10, "h": 6},
      "datasource": {"type": "prometheus", "uid": "magenta-prometheus"},
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(magenta_webui_llm_request_duration_seconds_bucket[5m]))", "legendFormat": "P50"},
        {"expr": "histogram_quantile(0.95, rate(magenta_webui_llm_request_duration_seconds_bucket[5m]))", "legendFormat": "P95"},
        {"expr": "histogram_quantile(0.99, rate(magenta_webui_llm_request_duration_seconds_bucket[5m]))", "legendFormat": "P99"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "s", "min": 0},
        "overrides": []
      }
    },
    {
      "title": "Token Throughput",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 6, "w": 8, "h": 6},
      "datasource": {"type": "prometheus", "uid": "magenta-prometheus"},
      "targets": [{"expr": "rate(magenta_webui_tokens_total[5m])", "legendFormat": "{{direction}}"}],
      "fieldConfig": {
        "defaults": {"unit": "short", "min": 0},
        "overrides": []
      }
    },
    {
      "title": "Approval Rate (24h)",
      "type": "timeseries",
      "gridPos": {"x": 8, "y": 6, "w": 8, "h": 6},
      "datasource": {"type": "prometheus", "uid": "magenta-prometheus"},
      "targets": [
        {"expr": "rate(magenta_webui_approval_actions_total{decision=\"approved\"}[24h])", "legendFormat": "Approved"},
        {"expr": "rate(magenta_webui_approval_actions_total{decision=\"denied\"}[24h])", "legendFormat": "Denied"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "ops", "min": 0},
        "overrides": []
      }
    },
    {
      "title": "Pipeline Call Volume",
      "type": "timeseries",
      "gridPos": {"x": 16, "y": 6, "w": 8, "h": 6},
      "datasource": {"type": "prometheus", "uid": "magenta-prometheus"},
      "targets": [{"expr": "rate(magenta_webui_pipeline_calls_total[5m])", "legendFormat": "{{pipeline}}"}],
      "fieldConfig": {
        "defaults": {"unit": "ops", "min": 0},
        "overrides": []
      }
    },
    {
      "title": "Error Rate by Endpoint",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 6},
      "datasource": {"type": "prometheus", "uid": "magenta-prometheus"},
      "targets": [{"expr": "rate(magenta_webui_http_requests_total{status=~\"5..\"}[5m]) / rate(magenta_webui_http_requests_total[5m]) * 100", "legendFormat": "{{method}} {{endpoint}}"}],
      "fieldConfig": {
        "defaults": {"unit": "percent", "min": 0, "max": 100},
        "overrides": []
      }
    },
    {
      "title": "Request Volume by User",
      "type": "barchart",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 6},
      "datasource": {"type": "prometheus", "uid": "magenta-prometheus"},
      "targets": [{"expr": "topk(10, sum(magenta_webui_user_requests_total) by (user))", "legendFormat": "{{user}}"}],
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": []
      }
    }
  ],
  "schemaVersion": 38,
  "time": {"from": "now-24h", "to": "now"},
  "refresh": "30s"
}
